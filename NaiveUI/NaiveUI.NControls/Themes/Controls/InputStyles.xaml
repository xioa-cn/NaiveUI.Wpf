    <Style x:Key="Naive.Input.InnerTextBoxStyle" TargetType="TextBox">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary.Brush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Primary.First.Brush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Primary.First.Brush}" />
        <Setter Property="SelectionOpacity" Value="0.28" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="AcceptsReturn" Value="False" />
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <ScrollViewer
                        x:Name="PART_ContentHost"
                        Focusable="False"
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        HorizontalScrollBarVisibility="Auto"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}"
                        Background="Transparent"
                        CanContentScroll="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Naive.Input.InnerPasswordBoxStyle" TargetType="PasswordBox">
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary.Brush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Primary.First.Brush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <ScrollViewer
                        x:Name="PART_ContentHost"
                        Focusable="False"
                        HorizontalAlignment="Stretch"
                        HorizontalScrollBarVisibility="Hidden"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        VerticalScrollBarVisibility="Hidden"
                        Background="Transparent"
                        CanContentScroll="False" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Naive.Input.IconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Tertiary.Brush}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        CornerRadius="11">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary.Brush}" />
                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource Theme.Surface.2.Brush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary.Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="NInputBaseStyle" TargetType="{x:Type controls:NInput}">
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="Height" Value="{Binding ResolvedHeight, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Background" Value="{DynamicResource Theme.Surface.0.Brush}" />
        <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Primary.Brush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Theme.Border.Brush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:NInput}">
                    <Border
                        x:Name="OuterBorder"
                        MinHeight="{TemplateBinding Height}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{Binding ResolvedCornerRadius, RelativeSource={RelativeSource TemplatedParent}}">
                        <Grid x:Name="RootGrid" MinHeight="{TemplateBinding Height}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition x:Name="PrefixColumn" Width="0" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition x:Name="ActionColumn" Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter
                                x:Name="PrefixPresenter"
                                Grid.Column="0"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Content="{TemplateBinding PrefixContent}"
                                Visibility="Collapsed" />

                            <Grid
                                x:Name="EditorLayer"
                                Grid.Column="1"
                                Margin="10,0,10,0"
                                VerticalAlignment="Stretch">
                                <TextBox
                                    x:Name="PART_TextBox"
                                    MaxLength="{TemplateBinding MaxLength}"
                                    IsReadOnly="{Binding IsEditorReadOnly, RelativeSource={RelativeSource TemplatedParent}}"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontStyle="{TemplateBinding FontStyle}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Style="{StaticResource Naive.Input.InnerTextBoxStyle}"
                                    Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Stretch" />

                                <PasswordBox
                                    x:Name="PART_PasswordBox"
                                    MaxLength="{TemplateBinding MaxLength}"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    FontStyle="{TemplateBinding FontStyle}"
                                    FontWeight="{TemplateBinding FontWeight}"
                                    Foreground="{TemplateBinding Foreground}"
                                    Style="{StaticResource Naive.Input.InnerPasswordBoxStyle}"
                                    VerticalAlignment="Stretch"
                                    Visibility="Collapsed" />

                                <TextBlock
                                    x:Name="PlaceholderText"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource Theme.Text.Tertiary.Brush}"
                                    IsHitTestVisible="False"
                                    Text="{TemplateBinding Placeholder}"
                                    Visibility="Collapsed" />
                            </Grid>

                            <StackPanel
                                x:Name="ActionPanel"
                                Grid.Column="2"
                                Margin="0,0,8,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    x:Name="CountText"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource Theme.Text.Tertiary.Brush}"
                                    Text="{Binding CountText, RelativeSource={RelativeSource TemplatedParent}}"
                                    Visibility="Collapsed" />

                                <ContentPresenter
                                    x:Name="SuffixPresenter"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding SuffixContent}"
                                    Visibility="Collapsed" />

                                <Grid
                                    x:Name="LoadingGlyph"
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,2,0"
                                    RenderTransformOrigin="0.5,0.5"
                                    Visibility="Collapsed">
                                    <Grid.RenderTransform>
                                        <RotateTransform />
                                    </Grid.RenderTransform>
                                    <Ellipse
                                        Width="16"
                                        Height="16"
                                        Opacity="0.45"
                                        Stroke="{DynamicResource Theme.Border.Strong.Brush}"
                                        StrokeThickness="2" />
                                    <Path
                                        Width="16"
                                        Height="16"
                                        Data="M 8,1 A 7,7 0 0 1 15,8"
                                        Stroke="{DynamicResource Primary.First.Brush}"
                                        StrokeEndLineCap="Round"
                                        StrokeStartLineCap="Round"
                                        StrokeThickness="2"
                                        Stretch="None" />
                                </Grid>

                                <Button
                                    x:Name="PART_PasswordToggleButton"
                                    Command="{x:Static controls:NInput.TogglePasswordVisibilityCommand}"
                                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                    Style="{StaticResource Naive.Input.IconButtonStyle}"
                                    Visibility="Collapsed">
                                    <Grid Width="16" Height="16">
                                        <Path
                                            x:Name="PasswordToggleIcon"
                                            Data="{StaticResource Naive.Input.EyeGeometry}"
                                            Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                            Stretch="Uniform" />
                                        <ContentPresenter
                                            x:Name="PasswordToggleCustomIcon"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Content="{Binding ResolvedPasswordIconContent, RelativeSource={RelativeSource TemplatedParent}}"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Button>

                                <Button
                                    x:Name="ClearButton"
                                    Command="{x:Static controls:NInput.ClearCommand}"
                                    CommandTarget="{Binding RelativeSource={RelativeSource TemplatedParent}}"
                                    Opacity="0"
                                    IsHitTestVisible="False"
                                    Style="{StaticResource Naive.Input.IconButtonStyle}"
                                    Visibility="Collapsed">
                                    <controls:NIcon
                                        Color="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                        Data="{StaticResource Close}"
                                        Size="12" />
                                </Button>
                            </StackPanel>

                            <Thumb
                                x:Name="PART_ResizeThumb"
                                Grid.Column="1"
                                Width="14"
                                Height="14"
                                Margin="0,0,3,3"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Bottom"
                                Cursor="SizeNWSE"
                                Opacity="0.72"
                                Panel.ZIndex="3"
                                Visibility="Collapsed">
                                <Thumb.Template>
                                    <ControlTemplate TargetType="Thumb">
                                        <Grid Background="Transparent">
                                            <Path
                                                Data="M8 12L12 8M4 12L12 4"
                                                Stroke="{DynamicResource Theme.Text.Tertiary.Brush}"
                                                StrokeEndLineCap="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="1.2"
                                                Stretch="None" />
                                        </Grid>
                                    </ControlTemplate>
                                </Thumb.Template>
                            </Thumb>
                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasText" Value="False">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="HasPrefix" Value="True">
                            <Setter TargetName="PrefixColumn" Property="Width" Value="Auto" />
                            <Setter TargetName="PrefixPresenter" Property="Visibility" Value="Visible" />
                            <Setter TargetName="EditorLayer" Property="Margin" Value="8,0,10,0" />
                        </Trigger>
                        <Trigger Property="HasSuffix" Value="True">
                            <Setter TargetName="SuffixPresenter" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowCount" Value="True">
                            <Setter TargetName="CountText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Type" Value="{x:Static controls:NInputType.Password}">
                            <Setter TargetName="PART_TextBox" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_PasswordBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_PasswordToggleButton" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Type" Value="{x:Static controls:NInputType.Password}" />
                                <Condition Property="IsPasswordVisible" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_TextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_PasswordBox" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PasswordToggleIcon" Property="Data" Value="{StaticResource Naive.Input.EyeOffGeometry}" />
                        </MultiTrigger>
                        <Trigger Property="HasCustomPasswordIcon" Value="True">
                            <Setter TargetName="PasswordToggleIcon" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PasswordToggleCustomIcon" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ShowPasswordToggle" Value="False">
                            <Setter TargetName="PART_PasswordToggleButton" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Type" Value="{x:Static controls:NInputType.Textarea}">
                            <Setter Property="Height" Value="Auto" />
                            <Setter TargetName="OuterBorder" Property="MinHeight" Value="{Binding ResolvedTextareaMinHeight, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="RootGrid" Property="MinHeight" Value="{Binding ResolvedTextareaMinHeight, RelativeSource={RelativeSource TemplatedParent}}" />
                            <Setter TargetName="ActionColumn" Property="Width" Value="0" />
                            <Setter TargetName="PrefixPresenter" Property="VerticalAlignment" Value="Top" />
                            <Setter TargetName="PrefixPresenter" Property="Margin" Value="10,8,0,0" />
                            <Setter TargetName="ActionPanel" Property="Grid.Column" Value="1" />
                            <Setter TargetName="ActionPanel" Property="Panel.ZIndex" Value="2" />
                            <Setter TargetName="ActionPanel" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="ActionPanel" Property="VerticalAlignment" Value="Bottom" />
                            <Setter TargetName="ActionPanel" Property="Margin" Value="0,0,10,7" />
                            <Setter TargetName="EditorLayer" Property="Margin" Value="10,7,10,26" />
                            <Setter TargetName="PART_TextBox" Property="VerticalContentAlignment" Value="Top" />
                            <Setter TargetName="PART_TextBox" Property="Padding" Value="0,1,0,0" />
                            <Setter TargetName="PART_TextBox" Property="AcceptsReturn" Value="True" />
                            <Setter TargetName="PART_TextBox" Property="TextWrapping" Value="Wrap" />
                            <Setter TargetName="PART_TextBox" Property="VerticalScrollBarVisibility" Value="Auto" />
                            <Setter TargetName="PlaceholderText" Property="VerticalAlignment" Value="Top" />
                            <Setter TargetName="PART_ResizeThumb" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Resizable" Value="False">
                            <Setter TargetName="PART_ResizeThumb" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Theme.Border.Strong.Brush}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Primary.First.Brush}" />
                        </Trigger>
                        <Trigger Property="Status" Value="{x:Static controls:NSelectStatus.Success}">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Success.First.Brush}" />
                        </Trigger>
                        <Trigger Property="Status" Value="{x:Static controls:NSelectStatus.Warning}">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Warning.First.Brush}" />
                        </Trigger>
                        <Trigger Property="Status" Value="{x:Static controls:NSelectStatus.Error}">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Error.First.Brush}" />
                        </Trigger>
                        <Trigger Property="IsInvalid" Value="True">
                            <Setter TargetName="OuterBorder" Property="BorderBrush" Value="{DynamicResource Error.First.Brush}" />
                        </Trigger>
                        <Trigger Property="Loading" Value="True">
                            <Setter TargetName="LoadingGlyph" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PART_TextBox" Property="IsHitTestVisible" Value="False" />
                            <Setter TargetName="PART_PasswordBox" Property="IsHitTestVisible" Value="False" />
                            <Setter TargetName="CountText" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="SuffixPresenter" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="ClearButton" Property="Opacity" Value="0" />
                            <Setter TargetName="ClearButton" Property="IsHitTestVisible" Value="False" />
                            <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_PasswordToggleButton" Property="Visibility" Value="Collapsed" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="InputLoadingStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            Storyboard.TargetName="LoadingGlyph"
                                            Storyboard.TargetProperty="(UIElement.RenderTransform).(RotateTransform.Angle)"
                                            From="0"
                                            To="360"
                                            Duration="0:0:0.9" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="InputLoadingStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="CanClear" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ClearButton" Property="Opacity" Value="1" />
                            <Setter TargetName="ClearButton" Property="IsHitTestVisible" Value="True" />
                            <Setter TargetName="ClearButton" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.55" />
                            <Setter TargetName="OuterBorder" Property="Background" Value="{DynamicResource Theme.Surface.1.Brush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource NInputBaseStyle}" TargetType="{x:Type controls:NInput}" />
</ResourceDictionary>
