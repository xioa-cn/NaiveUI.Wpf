<UserControl
    x:Class="NaiveUI.Demo.Views.Pages.InputDocsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nc="clr-namespace:NaiveUI.NControls.Controls;assembly=NaiveUI.NControls"
    xmlns:nu="clr-namespace:NaiveUI.NControls.ControlsExample;assembly=NaiveUI.NControls"
    xmlns:sections="clr-namespace:NaiveUI.Demo.Views.Sections"
    xmlns:showMeTheXaml="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
    xmlns:viewModels="clr-namespace:NaiveUI.Demo.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:InputDocsPageViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="SectionCardHeaderTitleStyle"
            BasedOn="{StaticResource DocSectionTitleStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
        </Style>

        <Style x:Key="DemoItemStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,24,18" />
        </Style>

        <Style x:Key="DemoCaptionStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary.Brush}" />
        </Style>

        <Geometry x:Key="InputDocsSearchGeometry">M797.525333 752.266667c62.069333-72.736 97.28-165.002667 97.28-262.186667C894.816 266.528 713.621333 85.333333 490.08 85.333333 266.538667 85.333333 85.333333 266.538667 85.333333 490.069333 85.333333 713.610667 266.538667 894.826667 490.069333 894.826667a404.693333 404.693333 0 0 0 118.208-17.546667 32 32 0 0 0-18.666666-61.216 340.693333 340.693333 0 0 1-99.541334 14.762667C301.888 830.816 149.333333 678.261333 149.333333 490.069333 149.333333 301.888 301.888 149.333333 490.069333 149.333333 678.261333 149.333333 830.826667 301.888 830.826667 490.069333c0 89.28-35.381333 173.696-97.141334 237.322667a36.992 36.992 0 0 0 0.384 51.925333l149.973334 149.973334a32 32 0 0 0 45.258666-45.248L797.525333 752.266667z</Geometry>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Theme.Surface.0.Brush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="25,34,18,34">
                <TextBlock
                    FontSize="48"
                    FontWeight="Bold"
                    Foreground="{DynamicResource Theme.Text.Primary.Brush}"
                    Text="文本输入 Input" />

                <TextBlock
                    Margin="0,26,0,0"
                    FontSize="18"
                    Foreground="{DynamicResource Theme.Text.Primary.Brush}"
                    Text="用于输入单行文本、密码和多行文本。WPF 版尽量对齐 Naive UI Input 的清空、计数、前后缀、状态、尺寸、密码显示和 textarea autosize 语义。" />

                <TextBlock
                    Margin="0,52,0,28"
                    FontSize="36"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Theme.Text.Primary.Brush}"
                    Text="演示" />

                <StackPanel>
                    <nu:CardElement x:Name="SectionBasic" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="基础用法" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="InputDocsPageBasic">
                                <StackPanel Margin="30,24,30,24">
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="默认输入框支持 Placeholder 和 Text 双向绑定。" />
                                    <nc:NInput
                                        Width="320"
                                        HorizontalAlignment="Left"
                                        Placeholder="请输入内容"
                                        Text="{Binding BasicText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionSize" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="尺寸" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="InputDocsPageSize">
                                <WrapPanel Margin="30,24,30,6">
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NInput
                                            Width="170"
                                            Placeholder="Tiny"
                                            Size="Tiny" />
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="Tiny" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NInput
                                            Width="190"
                                            Placeholder="Small"
                                            Size="Small" />
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="Small" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NInput
                                            Width="210"
                                            Placeholder="Medium"
                                            Size="Medium" />
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="Medium" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NInput
                                            Width="230"
                                            Placeholder="Large"
                                            Size="Large" />
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="Large" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NInput
                                            Width="230"
                                            Placeholder="Round"
                                            Round="True" />
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="Round" />
                                    </StackPanel>
                                </WrapPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionStatus" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="状态" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="InputDocsPageStatus">
                                <WrapPanel Margin="30,24,30,6">
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NInput Width="220" Placeholder="默认状态" />
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="Default" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NInput
                                            Width="220"
                                            Placeholder="成功状态"
                                            Status="Success" />
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="Success" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NInput
                                            Width="220"
                                            Placeholder="警告状态"
                                            Status="Warning" />
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="Warning" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NInput
                                            Width="220"
                                            IsInvalid="True"
                                            Placeholder="错误状态" />
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="Error" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NInput
                                            Width="220"
                                            Disabled="True"
                                            Text="Disabled" />
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="Disabled" />
                                    </StackPanel>
                                </WrapPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionClearable" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="可清空" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="InputDocsPageClearable">
                                <StackPanel Margin="30,24,30,24">
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="Clearable 会在鼠标移入且有内容时显示清空按钮，点击后触发 Clear 事件。" />
                                    <nc:NInput
                                        Width="320"
                                        Clearable="True"
                                        Text="{Binding ClearableText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionPassword" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="密码" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="InputDocsPagePassword">
                                <StackPanel Margin="30,24,30,24">
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="Type=Password 时默认显示密码切换按钮，Text 仍然可以参与绑定。" />
                                    <nc:NInput
                                        Width="320"
                                        Clearable="True"
                                        Placeholder="请输入密码"
                                        Text="{Binding PasswordText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Type="Password" />
                                    <nc:NInput
                                        Width="320"
                                        Margin="0,14,0,0"
                                        Clearable="True"
                                        Placeholder="自定义密码切换图标"
                                        Type="Password">
                                        <nc:NInput.PasswordHiddenIconContent>
                                            <Path
                                                Width="16"
                                                Height="16"
                                                Data="{StaticResource Naive.Input.EyeGeometry}"
                                                Fill="{DynamicResource Theme.Text.Tertiary.Brush}"
                                                Stretch="Uniform" />
                                        </nc:NInput.PasswordHiddenIconContent>
                                        <nc:NInput.PasswordVisibleIconContent>
                                            <Path
                                                Width="16"
                                                Height="16"
                                                Data="{StaticResource Naive.Input.EyeOffGeometry}"
                                                Fill="{DynamicResource Primary.First.Brush}"
                                                Stretch="Uniform" />
                                        </nc:NInput.PasswordVisibleIconContent>
                                    </nc:NInput>
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionAffix" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="前后缀" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="InputDocsPageAffix">
                                <StackPanel Margin="30,24,30,24">
                                    <nc:NInput
                                        Width="360"
                                        Clearable="True"
                                        Placeholder="搜索组件">
                                        <nc:NInput.PrefixContent>
                                            <Path
                                                Width="16"
                                                Height="16"
                                                Data="{StaticResource InputDocsSearchGeometry}"
                                                Fill="{DynamicResource Theme.Text.Tertiary.Brush}"
                                                Stretch="Uniform" />
                                        </nc:NInput.PrefixContent>
                                        <nc:NInput.SuffixContent>
                                            <TextBlock Foreground="{DynamicResource Theme.Text.Tertiary.Brush}" Text=".wpf" />
                                        </nc:NInput.SuffixContent>
                                    </nc:NInput>
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionCount" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="计数" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="InputDocsPageCount">
                                <StackPanel Margin="30,24,30,24">
                                    <nc:NInput
                                        Width="360"
                                        Clearable="True"
                                        MaxLength="24"
                                        Placeholder="最多 24 个字符"
                                        ShowCount="True" />
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionTextarea" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="文本域" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="InputDocsPageTextarea">
                                <StackPanel Margin="30,24,30,24">
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="Type=Textarea 支持多行输入、计数和 autosize 行数范围。" />
                                    
                                    <nc:NInput
                                        Width="480"
                                        Autosize="True"
                                        Clearable="True"
                                        MaxLength="360"
                                        MaxRows="6"
                                        MinRows="3"
                                        Placeholder="请输入说明"
                                        ShowCount="True"
                                        Text="{Binding TextareaText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Type="Textarea" />
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionLoading" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="加载与只读" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="InputDocsPageLoading">
                                <WrapPanel Margin="30,24,30,6">
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NInput
                                            Width="240"
                                            Loading="True"
                                            Text="正在校验..." />
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="Loading" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NInput
                                            Width="240"
                                            IsReadOnly="True"
                                            Text="Readonly value" />
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="IsReadOnly" />
                                    </StackPanel>
                                </WrapPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionEvent" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="事件" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="InputDocsPageEvent">
                                <StackPanel Margin="30,24,30,24">
                                    <nc:NInput
                                        Width="360"
                                        Clear="HandleInputClear"
                                        Clearable="True"
                                        Placeholder="输入内容观察事件"
                                        TextChanged="HandleInputTextChanged" />
                                    <TextBlock
                                        Margin="0,14,0,0"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="{Binding EventText}" />
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionApi" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="API" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <StackPanel Margin="30,24,30,24">
                                <TextBlock
                                    Margin="0,0,0,18"
                                    Style="{StaticResource DocBodyTextStyle}"
                                    Text="当前 WPF 版 Input 重点对齐 Naive UI 的核心能力：基础输入、密码、textarea、可清空、状态、尺寸、计数、前后缀、加载、禁用、只读和事件模型。" />
                                <sections:ApiDocTable ItemsSource="{Binding InputPropsRows}" />
                                <TextBlock
                                    Margin="0,28,0,18"
                                    Style="{StaticResource SectionCardHeaderTitleStyle}"
                                    Text="事件" />
                                <sections:ApiDocTable ItemsSource="{Binding InputEventRows}" />
                            </StackPanel>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="{DynamicResource Theme.Surface.0.Brush}">
            <nc:NMenu
                Margin="20,36,20,20"
                DisplayMemberPath="Label"
                ItemInvoked="HandleOutlineItemInvoked"
                ItemsSource="{Binding OutlineItems}"
                SelectedValuePath="TargetName" />
        </Border>
    </Grid>
</UserControl>
