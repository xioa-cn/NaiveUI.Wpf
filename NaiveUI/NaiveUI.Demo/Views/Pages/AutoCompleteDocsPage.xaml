<UserControl
    x:Class="NaiveUI.Demo.Views.Pages.AutoCompleteDocsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nc="clr-namespace:NaiveUI.NControls.Controls;assembly=NaiveUI.NControls"
    xmlns:nu="clr-namespace:NaiveUI.NControls.ControlsExample;assembly=NaiveUI.NControls"
    xmlns:sections="clr-namespace:NaiveUI.Demo.Views.Sections"
    xmlns:showMeTheXaml="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
    xmlns:viewModels="clr-namespace:NaiveUI.Demo.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:AutoCompleteDocsPageViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="SectionCardHeaderTitleStyle"
            BasedOn="{StaticResource DocSectionTitleStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
        </Style>

        <Style x:Key="DemoItemStyle" TargetType="StackPanel">
            <Setter Property="Margin" Value="0,0,24,18" />
        </Style>

        <Style x:Key="DemoCaptionStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,8,0,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary.Brush}" />
        </Style>

        <DataTemplate x:Key="CityOptionTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource Theme.Text.Primary.Brush}"
                        Text="{Binding Label}" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource Theme.Text.Tertiary.Brush}"
                        Text="{Binding Group}" />
                </StackPanel>
                <TextBlock
                    Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Theme.Text.Tertiary.Brush}"
                    Text="{Binding Suffix}" />
            </Grid>
        </DataTemplate>

        <Geometry x:Key="SearchGeometry">M11.5 11.5L15 15M13 7.5C13 10.5376 10.5376 13 7.5 13C4.46243 13 2 10.5376 2 7.5C2 4.46243 4.46243 2 7.5 2C10.5376 2 13 4.46243 13 7.5Z</Geometry>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Theme.Surface.0.Brush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="25,34,18,34">
                <TextBlock
                    FontSize="48"
                    FontWeight="Bold"
                    Foreground="{DynamicResource Theme.Text.Primary.Brush}"
                    Text="自动填充" />

                <TextBlock
                    Margin="0,26,0,0"
                    FontSize="18"
                    Foreground="{DynamicResource Theme.Text.Primary.Brush}"
                    Text="以输入文本为主状态，由调用方根据 Text 生成候选项，同时保留内部过滤、补全提示、远程搜索和手动控制能力。" />

                <TextBlock
                    Margin="0,52,0,28"
                    FontSize="36"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Theme.Text.Primary.Brush}"
                    Text="演示" />

                <StackPanel>
                    <nu:CardElement x:Name="SectionBasic" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="基础用法" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="AutoCompleteDocsPageBasic">
                                <StackPanel Margin="30,24,30,24">
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="输入邮箱前缀后，候选项会追加常用邮箱后缀。选择后同步 Text 和 Value。" />
                                    <nc:NAutoComplete
                                        x:Name="BasicAutoComplete"
                                        Width="320"
                                        HorizontalAlignment="Left"
                                        Clearable="True"
                                        DisplayMemberPath="Label"
                                        FontFamily="Consolas"
                                        FontSize="15"
                                        ItemsSource="{Binding BasicOptions}"
                                        OptionSelected="HandleOptionSelected"
                                        Placeholder="请输入邮箱前缀"
                                        Text="{Binding BasicText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ValueChanged="HandleValueChanged"
                                        ValueMemberPath="Value"
                                        Value="{Binding BasicValue, Mode=TwoWay}" />
                                    <TextBlock
                                        Margin="0,14,0,0"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="{Binding ValueChangedText}" />
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionCompletion" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="补全提示" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="AutoCompleteDocsPageCompletion">
                                <StackPanel Margin="30,24,30,24">
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="聚焦后输入内容，输入框内的灰色尾巴是补全提示，按 Tab 接受。" />
                                    <nc:NAutoComplete
                                        x:Name="CompletionAutoComplete"
                                        Width="340"
                                        HorizontalAlignment="Left"
                                        AcceptSuggestionOnTab="True"
                                        Clearable="True"
                                        DisplayMemberPath="Label"
                                        FontFamily="Consolas"
                                        FontSize="15"
                                        ItemsSource="{Binding CompletionOptions}"
                                        Placeholder="试试输入 xiaoming"
                                        SelectFirstOptionOnOpen="True"
                                        ShowCompletionHint="True"
                                        Text="{Binding CompletionText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ValueChanged="HandleValueChanged"
                                        ValueMemberPath="Value"
                                        Value="{Binding CompletionValue, Mode=TwoWay}" />
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionSizeState" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="尺寸与状态" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="AutoCompleteDocsPageSizeState">
                                <WrapPanel Margin="30,24,30,6">
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NAutoComplete Width="170" Placeholder="极小尺寸" Size="Tiny">
                                            <nc:NSelectOption Label="demo@qq.com" Value="demo@qq.com" />
                                        </nc:NAutoComplete>
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="Tiny" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NAutoComplete Width="190" Placeholder="小尺寸" Size="Small">
                                            <nc:NSelectOption Label="demo@163.com" Value="demo@163.com" />
                                        </nc:NAutoComplete>
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="Small" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NAutoComplete Width="210" Placeholder="成功状态" Status="Success">
                                            <nc:NSelectOption Label="success@example.com" Value="success@example.com" />
                                        </nc:NAutoComplete>
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="Success" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NAutoComplete Width="230" IsInvalid="True" Placeholder="错误状态" Size="Large">
                                            <nc:NSelectOption Label="error@example.com" Value="error@example.com" />
                                        </nc:NAutoComplete>
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="Invalid + Large" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NAutoComplete Width="230" IsReadOnly="True" Text="readonly@example.com" />
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="IsReadOnly" />
                                    </StackPanel>
                                </WrapPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionAffix" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="前后缀" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="AutoCompleteDocsPageAffix">
                                <StackPanel Margin="30,24,30,24">
                                    <nc:NAutoComplete
                                        x:Name="PrefixAutoComplete"
                                        Width="320"
                                        Clearable="True"
                                        DisplayMemberPath="Label"
                                        ItemsSource="{Binding PrefixOptions}"
                                        Placeholder="搜索城市"
                                        SuffixContent="城市"
                                        Text="{Binding PrefixText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ValueChanged="HandleValueChanged"
                                        ValueMemberPath="Value"
                                        Value="{Binding PrefixValue, Mode=TwoWay}">
                                        <nc:NAutoComplete.PrefixContent>
                                            <nc:NIcon
                                                Data="{StaticResource SearchGeometry}"
                                                Size="16"
                                                StrokeThickness="1.35"
                                                UseStroke="True"
                                                Color="{DynamicResource Theme.Text.Tertiary.Brush}" />
                                        </nc:NAutoComplete.PrefixContent>
                                    </nc:NAutoComplete>
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionFilter" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="过滤与禁用" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="AutoCompleteDocsPageFilter">
                                <WrapPanel Margin="30,24,30,6">
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NAutoComplete
                                            Width="260"
                                            Clearable="True"
                                            EnableInternalFilter="True"
                                            ItemsSource="{Binding InternalFilterOptions}"
                                            MatchMode="Contains"
                                            Placeholder="内部过滤城市"
                                            SelectFirstOptionOnOpen="True"
                                            ShowArrow="True"
                                            Text="{Binding InternalFilterText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                            ValueMemberPath="Value"
                                            Value="{Binding InternalFilterValue, Mode=TwoWay}" />
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="EnableInternalFilter" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NAutoComplete
                                            Width="260"
                                            EnableInternalFilter="True"
                                            MinCharacters="2"
                                            Placeholder="至少输入 2 个字符"
                                            ShowArrow="True">
                                            <nc:NSelectOption Label="Alpha" Value="Alpha" />
                                            <nc:NSelectOption Label="Beta" Value="Beta" Disabled="True" />
                                            <nc:NSelectOption Label="Gamma" Value="Gamma" />
                                        </nc:NAutoComplete>
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="MinCharacters + Disabled" />
                                    </StackPanel>
                                </WrapPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionRemote" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="远程搜索" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="AutoCompleteDocsPageRemote">
                                <StackPanel Margin="30,24,30,24">
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="这里用延迟任务模拟远程搜索：输入变化后外部更新 ItemsSource，并通过 Loading 展示加载状态。" />
                                    <nc:NAutoComplete
                                        Width="340"
                                        Clearable="True"
                                        DisplayMemberPath="Label"
                                        ItemsSource="{Binding RemoteOptions}"
                                        Loading="{Binding RemoteLoading}"
                                        LoadingContent="搜索中..."
                                        Placeholder="搜索歌曲"
                                        Text="{Binding RemoteText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ValueChanged="HandleRemoteValueChanged"
                                        ValueMemberPath="Value"
                                        Value="{Binding RemoteValue, Mode=TwoWay}" />
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionTemplate" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="自定义渲染" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="AutoCompleteDocsPageTemplate">
                                <StackPanel Margin="30,24,30,24">
                                    <nc:NAutoComplete
                                        x:Name="TemplateAutoComplete"
                                        Width="340"
                                        ActionContent="管理"
                                        Clearable="True"
                                        DisplayMemberPath="Label"
                                        HeaderContent="热门城市"
                                        ItemsSource="{Binding TemplateOptions}"
                                        OptionTemplate="{StaticResource CityOptionTemplate}"
                                        Placeholder="输入城市名称"
                                        Text="{Binding TemplateText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        ValueChanged="HandleValueChanged"
                                        ValueMemberPath="Value"
                                        Value="{Binding TemplateValue, Mode=TwoWay}" />
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionLoadingEmpty" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="空状态与加载" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="AutoCompleteDocsPageLoadingEmpty">
                                <WrapPanel Margin="30,24,30,6">
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NAutoComplete
                                            Width="260"
                                            Loading="True"
                                            LoadingContent="搜索中..."
                                            Placeholder="自定义加载文案"
                                            ShowArrow="True"
                                            Trigger="Manual"
                                            IsDropDownOpen="True" />
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="LoadingContent" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NAutoComplete
                                            Width="260"
                                            NoDataContent="没有可显示的数据"
                                            Placeholder="自定义空状态"
                                            ShowArrow="True"
                                            Trigger="Manual"
                                            IsDropDownOpen="True" />
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="NoDataContent" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NAutoComplete
                                            Width="260"
                                            Placeholder="无匹配时不显示面板"
                                            ShowEmptyWhenNoMatch="False"
                                            ShowArrow="True" />
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="ShowEmptyWhenNoMatch=False" />
                                    </StackPanel>
                                </WrapPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionFocusBlur" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="焦点控制" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <StackPanel Margin="30,24,30,24">
                                <nc:NAutoComplete
                                    x:Name="DemoFocusAutoComplete"
                                    Width="320"
                                    Clearable="True"
                                    OpenOnFocus="True"
                                    Placeholder="点击按钮控制焦点"
                                    Text="{Binding FocusText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Value="{Binding FocusValue, Mode=TwoWay}">
                                    <nc:NSelectOption Label="Focus option 1" Value="focus-1" />
                                    <nc:NSelectOption Label="Focus option 2" Value="focus-2" />
                                </nc:NAutoComplete>
                                <StackPanel Margin="0,14,0,0" Orientation="Horizontal">
                                    <nc:NButton Content="Focus()" Click="HandleFocusClick" />
                                    <nc:NButton Margin="10,0,0,0" Content="Blur()" Click="HandleBlurClick" />
                                </StackPanel>
                                <TextBlock
                                    Margin="0,12,0,0"
                                    Style="{StaticResource DocBodyTextStyle}"
                                    Text="{Binding FocusStatusText}" />
                            </StackPanel>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionBehavior" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="触发与行为" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="AutoCompleteDocsPageBehavior">
                                <WrapPanel Margin="30,24,30,6">
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NAutoComplete Width="260" OpenOnFocus="True" Placeholder="聚焦时打开">
                                            <nc:NSelectOption Label="focus@qq.com" Value="focus@qq.com" />
                                            <nc:NSelectOption Label="focus@163.com" Value="focus@163.com" />
                                        </nc:NAutoComplete>
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="OpenOnFocus" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NAutoComplete
                                            Width="260"
                                            ClearAfterSelect="True"
                                            Placeholder="选择后清空输入">
                                            <nc:NSelectOption Label="clear-after-select" Value="clear-after-select" />
                                            <nc:NSelectOption Label="keep value only" Value="keep-value-only" />
                                        </nc:NAutoComplete>
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="ClearAfterSelect" />
                                    </StackPanel>
                                    <StackPanel Style="{StaticResource DemoItemStyle}">
                                        <nc:NAutoComplete
                                            Width="260"
                                            CloseOnSelect="False"
                                            Placeholder="选择后保持面板">
                                            <nc:NSelectOption Label="keep open 1" Value="1" />
                                            <nc:NSelectOption Label="keep open 2" Value="2" />
                                        </nc:NAutoComplete>
                                        <TextBlock Style="{StaticResource DemoCaptionStyle}" Text="CloseOnSelect=False" />
                                    </StackPanel>
                                </WrapPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionApi" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="API" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <TextBlock
                                Margin="30,24,30,24"
                                Style="{StaticResource DocBodyTextStyle}"
                                Text="当前控件聚焦真实自动补全语义：文本优先、调用方驱动候选项、可选内部过滤、键盘导航、Tab 补全、远程搜索、清除、状态、模板和手动焦点控制。" />
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionProps" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="属性" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <sections:ApiDocTable Margin="30,24,30,24" ItemsSource="{Binding PropsRows}" />
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionEvents" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="事件" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <sections:ApiDocTable Margin="30,24,30,24" ItemsSource="{Binding EventRows}" />
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionMethods" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="方法" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <sections:ApiDocTable Margin="30,24,30,24" ItemsSource="{Binding MethodRows}" />
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="{DynamicResource Theme.Surface.0.Brush}">
            <nc:NMenu
                Margin="20,36,20,20"
                DisplayMemberPath="Label"
                ItemInvoked="HandleOutlineItemInvoked"
                ItemsSource="{Binding OutlineItems}"
                SelectedValuePath="TargetName" />
        </Border>
    </Grid>
</UserControl>
