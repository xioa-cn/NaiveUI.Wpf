<UserControl
    x:Class="NaiveUI.Demo.Views.Pages.SliderDocsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:nc="clr-namespace:NaiveUI.NControls.Controls;assembly=NaiveUI.NControls"
    xmlns:nu="clr-namespace:NaiveUI.NControls.ControlsExample;assembly=NaiveUI.NControls"
    xmlns:sections="clr-namespace:NaiveUI.Demo.Views.Sections"
    xmlns:showMeTheXaml="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
    xmlns:viewModels="clr-namespace:NaiveUI.Demo.ViewModels"
    d:DataContext="{d:DesignInstance Type=viewModels:SliderDocsPageViewModel}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <Style
            x:Key="SectionCardHeaderTitleStyle"
            BasedOn="{StaticResource DocSectionTitleStyle}"
            TargetType="TextBlock">
            <Setter Property="FontSize" Value="18" />
        </Style>

        <Style
            x:Key="SliderDemoStatusStyle"
            BasedOn="{StaticResource DocBodyTextStyle}"
            TargetType="TextBlock">
            <Setter Property="Margin" Value="0,18,0,0" />
        </Style>

        <Style x:Key="SliderDemoLabelStyle" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource Theme.Text.Secondary.Brush}" />
        </Style>

        <DataTemplate x:Key="SliderIndicatorTemplate">
            <StackPanel Orientation="Horizontal">
                <Ellipse
                    Width="6"
                    Height="6"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Fill="{DynamicResource Success.First.Brush}" />
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource Theme.Tooltip.Foreground.Brush}"
                    Text="{Binding StringFormat={}{0:0} 分}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="SliderMarkTemplate">
            <nc:NTag
                Bordered="False"
                Size="Tiny"
                Type="Info">
                <TextBlock Text="{Binding Label}" />
            </nc:NTag>
        </DataTemplate>

        <DataTemplate x:Key="SliderMarkDotTemplate">
            <Border
                Width="14"
                Height="14"
                Background="{DynamicResource Theme.Surface.0.Brush}"
                BorderBrush="{DynamicResource Info.First.Brush}"
                BorderThickness="2"
                CornerRadius="7">
                <Ellipse
                    Width="4"
                    Height="4"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Fill="{DynamicResource Info.First.Brush}" />
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SliderThumbTemplate">
            <Border
                Width="28"
                Height="28"
                Background="{DynamicResource Warning.First.Brush}"
                CornerRadius="14">
                <Path
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Data="M615.005917 647.451804l-23.650315-1.075015c-90.594388-3.811414-186.270662-46.225616-187.150219-46.616529l-25.018515-11.238786-8.306929 26.093529c-15.343386 48.082458-60.591716 102.712731-61.080359 103.201374l-6.841 8.2092 1.3682 10.652415c6.743272 51.014316 17.395686 95.187631 31.664058 131.640389h53.164344c-15.538843-32.934529-27.461729-76.814659-34.986829-127.731246 12.118343-15.538843 37.136858-49.841573 53.750716-86.587517 32.445887 12.509257 94.014888 33.129987 158.32029 39.580073 2.247757 48.962016 12.900172 115.026532 37.039129 174.73869h53.45753c-29.904944-62.741745-42.609658-143.856461-42.023287-197.216262l0.293186-23.650315z M872.813896 295.43348c-11.141057-12.118343-29.123115-20.425272-47.007444-25.898072-17.493415-34.98683-55.118916-57.56213-100.171789-57.562131-11.922886 0-23.259401 1.954571-33.911815 5.570529-1.172743-13.877458 1.954571-28.048101 9.479672-40.361901a24.481008 24.481008 0 0 0-41.82783-25.409429c-17.493415 28.829929-21.500286 63.425845-11.434243 95.089902-3.4205 4.006872-6.645543 8.111472-9.284215 12.509258-13.095629 20.913915-18.666158 46.61653-15.538843 72.807788 3.518229 29.123115 1.563657 41.82783-1.759115 50.916587-33.814087 45.834701-93.721703 31.566329-145.322389 18.959343-38.798244-9.479672-78.866959-19.154801-121.378889-5.4728-21.207101 6.841-38.211872 16.027486-51.893873 26.973086-2.540943 2.0523-4.7887 4.202329-7.231915 6.352358-4.397786 0-8.404657-0.781829-9.870586-1.075015l-2.247757-0.488642c-22.184386-3.322772-37.527772-24.236686-34.205001-46.421073 3.322772-22.184386 24.236686-37.527772 46.421073-34.205001 13.388815 2.0523 25.800344-7.134186 27.852643-20.523001s-7.134186-25.800344-20.523-27.852643c-48.864287-7.427372-94.60126 26.288986-102.028632 75.153273-6.743272 44.56423 20.718458 86.39206 62.644016 99.096774-17.493415 38.114144-16.907043 78.573774-16.4184 99.780875v1.759114c0.977286 40.752815-4.495514 54.337087-13.388815 76.814659-4.7887 11.922886-10.750143 26.777629-16.4184 47.789273-16.809315