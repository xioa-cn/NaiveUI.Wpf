                    Fill="{DynamicResource Theme.Text.Inverse.Brush}"
                    Stretch="Uniform" />
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource Theme.Surface.0.Brush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="220" />
        </Grid.ColumnDefinitions>

        <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="25,34,18,34">
                <TextBlock
                    FontSize="48"
                    FontWeight="Bold"
                    Foreground="{DynamicResource Theme.Text.Primary.Brush}"
                    Text="滑动选择 Slider" />

                <TextBlock
                    Margin="0,26,0,0"
                    FontSize="18"
                    Foreground="{DynamicResource Theme.Text.Primary.Brush}"
                    Text="通过拖动滑块在连续或离散区间内选择数值。" />

                <TextBlock
                    Margin="0,52,0,28"
                    FontSize="36"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource Theme.Text.Primary.Brush}"
                    Text="演示" />

                <StackPanel>
                    <nu:CardElement x:Name="SectionBasic" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="基础用法" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="SliderDocsPageBasic">
                                <StackPanel Margin="30,24,30,24">
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="最基本的滑动选择器。Value 支持双向绑定，默认范围为 0 到 100。" />
                                    <nc:NSlider
                                        Width="360"
                                        HorizontalAlignment="Left"
                                        Value="{Binding BasicValue, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource SliderDemoStatusStyle}" Text="{Binding BasicStatusText}" />
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionDisabled" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="禁用" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="SliderDocsPageDisabled">
                                <StackPanel Margin="30,24,30,24">
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="Disabled 会同步到 IsEnabled，并保留轨道、填充和滑块的禁用态透明度。" />
                                    <nc:NSlider
                                        Width="360"
                                        HorizontalAlignment="Left"
                                        Disabled="True"
                                        Value="45" />
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionStep" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="步长" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="SliderDocsPageStep">
                                <StackPanel Margin="30,24,30,24">
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="Step 对齐 Naive UI 的 step。键盘方向键也会按相同步长推进。" />
                                    <nc:NSlider
                                        Width="360"
                                        HorizontalAlignment="Left"
                                        ShowTooltip="True"
                                        Step="10"
                                        TooltipSuffix="%"
                                        Value="{Binding StepValue, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource SliderDemoStatusStyle}" Text="{Binding StepStatusText}" />
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionRailSize" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="轨道粗度" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="SliderDocsPageRailSize">
                                <StackPanel Margin="30,24,30,24">
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="RailSize 可以统一设置轨道粗度，轨道和填充条两端圆角会根据粗度自动计算。" />
                                    <TextBlock Style="{StaticResource SliderDemoLabelStyle}" Text="较粗的水平轨道" />
                                    <nc:NSlider
                                        Width="380"
                                        HorizontalAlignment="Left"
                                        HandleSize="18"
                                        RailSize="8"
                                        ShowTooltip="True"
                                        Value="58" />
                                    <TextBlock
                                        Margin="0,24,0,10"
                                        Style="{StaticResource SliderDemoLabelStyle}"
                                        Text="垂直轨道单独设置粗度" />
                                    <nc:NSlider
                                        Height="180"
                                        HandleSize="18"
                                        Placement="Right"
                                        RailWidthVertical="10"
                                        ShowTooltip="True"
                                        Vertical="True"
                                        Value="42" />
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionRange" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="范围选择" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="SliderDocsPageRange">
                                <StackPanel Margin="30,24,30,24">
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="Range 开启后显示两个滑块。WPF 版使用 RangeStart 和 RangeEnd 代替数组值，便于直接双向绑定。" />
                                    <nc:NSlider
                                        Width="360"
                                        HorizontalAlignment="Left"
                                        Range="True"
                                        RangeEnd="{Binding RangeEnd, Mode=TwoWay}"
                                        RangeStart="{Binding RangeStart, Mode=TwoWay}"
                                        ShowTooltip="True"
                                        Step="2" />
                                    <TextBlock Style="{StaticResource SliderDemoStatusStyle}" Text="{Binding RangeStatusText}" />
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionMarks" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="标记" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="SliderDocsPageMarks">
                                <StackPanel Margin="30,24,30,38">
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="Marks 用来在轨道上显示离散刻度和标签，激活区间内的标记点会使用主题主色。" />
                                    <nc:NSlider
                                        Width="420"
                                        HorizontalAlignment="Left"
                                        ShowTooltip="True"
                                        Value="{Binding MarkValue, Mode=TwoWay}">
                                        <nc:NSlider.Marks>
                                            <nc:NSliderMarkCollection>
                                                <nc:NSliderMark Label="0℃" Value="0" />
                                                <nc:NSliderMark Label="20℃" Value="20" />
                                                <nc:NSliderMark Label="体温" Value="37" />
                                                <nc:NSliderMark Label="80℃" Value="80" />
                                                <nc:NSliderMark Label="100℃" Value="100" />
                                            </nc:NSliderMarkCollection>
                                        </nc:NSlider.Marks>
                                    </nc:NSlider>
                                    <TextBlock Style="{StaticResource SliderDemoStatusStyle}" Text="{Binding MarkStatusText}" />
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionStepMark" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="只在标记间选择" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="SliderDocsPageStepMark">
                                <StackPanel Margin="30,24,30,38">
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="当 Step 写成 mark 时，拖动和键盘操作都会吸附到最近的标记点。" />
                                    <nc:NSlider
                                        Width="420"
                                        HorizontalAlignment="Left"
                                        ShowTooltip="True"
                                        Step="mark"
                                        Value="37">
                                        <nc:NSlider.Marks>
                                            <nc:NSliderMarkCollection>
                                                <nc:NSliderMark Label="差" Value="0" />
                                                <nc:NSliderMark Label="刚好" Value="37" />
                                                <nc:NSliderMark Label="偏高" Value="72" />
                                                <nc:NSliderMark Label="危险" Value="100" />
                                            </nc:NSliderMarkCollection>
                                        </nc:NSlider.Marks>
                                    </nc:NSlider>
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionCustomMark" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="自定义标识和标记" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="SliderDocsPageCustomMark">
                                <StackPanel Margin="30,24,30,44">
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="IndicatorTemplate 用来自定义提示标识，MarkTemplate 和 MarkDotTemplate 用来自定义标记内容和标记点。" />
                                    <nc:NSlider
                                        Width="440"
                                        HorizontalAlignment="Left"
                                        IndicatorTemplate="{StaticResource SliderIndicatorTemplate}"
                                        MarkDotTemplate="{StaticResource SliderMarkDotTemplate}"
                                        MarkTemplate="{StaticResource SliderMarkTemplate}"
                                        ShowTooltip="True"
                                        Step="mark"
                                        Value="40">
                                        <nc:NSlider.Marks>
                                            <nc:NSliderMarkCollection>
                                                <nc:NSliderMark Label="低" Value="0" />
                                                <nc:NSliderMark Label="推荐" Value="40" />
                                                <nc:NSliderMark Label="偏高" Value="70" />
                                                <nc:NSliderMark Label="上限" Value="100" />
                                            </nc:NSliderMarkCollection>
                                        </nc:NSlider.Marks>
                                    </nc:NSlider>
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionCustomThumb" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="自定义滑块按钮" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="SliderDocsPageCustomThumb">
                                <StackPanel Margin="30,24,30,24">
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="ThumbTemplate 可以用 Path 图标替代默认圆形滑块按钮，模板的 DataContext 是当前滑块值。" />
                                    <nc:NSlider
                                        Width="420"
                                        HorizontalAlignment="Left"
                                        HandleSize="28"
                                        RailSize="12"
                                        ThumbTemplate="{StaticResource SliderThumbTemplate}"
                                        Value="62" />
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionTooltip" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="提示" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="SliderDocsPageTooltip">
                                <StackPanel Margin="30,24,30,24">
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="Tooltip 控制是否显示提示；ShowTooltip=True 时始终显示。FormatString、TooltipPrefix 和 TooltipSuffix 可快速格式化提示内容。" />
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource SliderDemoLabelStyle}" Text="始终显示百分比" />
                                        <nc:NSlider
                                            Width="360"
                                            HorizontalAlignment="Left"
                                            FormatString="P0"
                                            Max="1"
                                            ShowTooltip="True"
                                            Step="0.05"
                                            Value="0.45" />
                                        <TextBlock
                                            Margin="0,22,0,10"
                                            Style="{StaticResource SliderDemoLabelStyle}"
                                            Text="不显示提示" />
                                        <nc:NSlider
                                            Width="360"
                                            HorizontalAlignment="Left"
                                            Tooltip="False"
                                            Value="60" />
                                    </StackPanel>
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionVerticalReverse" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="垂直和反向" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="SliderDocsPageVerticalReverse">
                                <StackPanel Margin="30,24,30,24">
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="Vertical 和 Reverse 可以组合使用，键盘方向也会随方向修正。" />
                                    <StackPanel Orientation="Horizontal">
                                        <StackPanel Margin="0,0,46,0">
                                            <TextBlock Style="{StaticResource SliderDemoLabelStyle}" Text="垂直" />
                                            <nc:NSlider
                                                Height="180"
                                                Placement="Right"
                                                ShowTooltip="True"
                                                Vertical="True"
                                                Value="{Binding VerticalValue, Mode=TwoWay}" />
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource SliderDemoLabelStyle}" Text="水平反向" />
                                            <nc:NSlider
                                                Width="360"
                                                Reverse="True"
                                                ShowTooltip="True"
                                                Value="{Binding ReverseValue, Mode=TwoWay}" />
                                        </StackPanel>
                                    </StackPanel>
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionControl" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="内部控件联动" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="SliderDocsPageControl">
                                <StackPanel Margin="30,24,30,24">
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="组合使用 NButton、NSwitch 和 NInput，展示 Slider 在受控场景下的禁用、提示、反向和重置。" />
                                    <WrapPanel Margin="0,0,0,18">
                                        <StackPanel Margin="0,0,26,14">
                                            <nc:NSwitch IsChecked="{Binding LinkedDisabled, Mode=TwoWay}" />
                                            <TextBlock Style="{StaticResource SliderDemoLabelStyle}" Text="禁用" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,26,14">
                                            <nc:NSwitch IsChecked="{Binding LinkedShowTooltip, Mode=TwoWay}" />
                                            <TextBlock Style="{StaticResource SliderDemoLabelStyle}" Text="显示提示" />
                                        </StackPanel>
                                        <StackPanel Margin="0,0,26,14">
                                            <nc:NSwitch IsChecked="{Binding LinkedReverse, Mode=TwoWay}" />
                                            <TextBlock Style="{StaticResource SliderDemoLabelStyle}" Text="反向" />
                                        </StackPanel>
                                    </WrapPanel>
                                    <StackPanel Margin="0,0,0,18" Orientation="Horizontal">
                                        <nc:NButton
                                            Margin="0,0,12,0"
                                            Click="HandleResetLinkedSliderClick"
                                            Kind="Secondary">
                                            重置
                                        </nc:NButton>
                                        <nc:NInput
                                            Width="160"
                                            IsReadOnly="True"
                                            Text="{Binding LinkedValue, Mode=TwoWay}" />
                                    </StackPanel>
                                    <nc:NSlider
                                        x:Name="LinkedSlider"
                                        Width="420"
                                        HorizontalAlignment="Left"
                                        DefaultValue="44"
                                        Disabled="{Binding LinkedDisabled}"
                                        Reverse="{Binding LinkedReverse}"
                                        ShowTooltip="{Binding LinkedShowTooltip}"
                                        Step="4"
                                        TooltipSuffix="%"
                                        Value="{Binding LinkedValue, Mode=TwoWay}" />
                                    <TextBlock Style="{StaticResource SliderDemoStatusStyle}" Text="{Binding LinkedStatusText}" />
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionEvent" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="事件" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <showMeTheXaml:XamlDisplay Style="{StaticResource AvalonEditXamlDisplay}" UniqueKey="SliderDocsPageEvent">
                                <StackPanel Margin="30,24,30,24">
                                    <TextBlock
                                        Margin="0,0,0,20"
                                        Style="{StaticResource DocBodyTextStyle}"
                                        Text="ValueChanged 对齐 on-update:value，DragStarted 和 DragCompleted 对齐 on-dragstart / on-dragend。" />
                                    <StackPanel Orientation="Horizontal">
                                        <nc:NButton
                                            Margin="0,0,18,0"
                                            Click="HandleResetEventSliderClick"
                                            Kind="Secondary">
                                            重置
                                        </nc:NButton>
                                        <nc:NSlider
                                            x:Name="EventSlider"
                                            Width="360"
                                            DefaultValue="30"
                                            DragCompleted="HandleEventSliderDragCompleted"
                                            DragStarted="HandleEventSliderDragStarted"
                                            ShowTooltip="True"
                                            ValueChanged="HandleEventSliderValueChanged"
                                            Value="30" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SliderDemoStatusStyle}" Text="{Binding EventText}" />
                                </StackPanel>
                            </showMeTheXaml:XamlDisplay>
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionApi" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="API" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <TextBlock
                                Margin="30,24,30,24"
                                Style="{StaticResource DocBodyTextStyle}"
                                Text="基础 Props 对齐 Naive UI Slider；WPF 版额外开放主题画刷、尺寸、事件和 Reset 方法。" />
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionSliderProps" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="Slider Props" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <sections:ApiDocTable Margin="30,24,30,24" ItemsSource="{Binding SliderPropsRows}" />
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionSliderEvents" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="Slider Events" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <sections:ApiDocTable Margin="30,24,30,24" ItemsSource="{Binding SliderEventRows}" />
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionSliderMethods" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="Slider Methods" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <sections:ApiDocTable Margin="30,24,30,24" ItemsSource="{Binding SliderMethodRows}" />
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>

                    <nu:CardElement x:Name="SectionSliderMark" Margin="0,0,0,20">
                        <nu:CardElement.HeaderElement>
                            <Grid Margin="30,28,30,0">
                                <TextBlock Style="{StaticResource SectionCardHeaderTitleStyle}" Text="Slider Mark" />
                            </Grid>
                        </nu:CardElement.HeaderElement>
                        <nu:CardElement.ContentElement>
                            <sections:ApiDocTable Margin="30,24,30,24" ItemsSource="{Binding SliderMarkRows}" />
                        </nu:CardElement.ContentElement>
                    </nu:CardElement>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Column="1" Background="{DynamicResource Theme.Surface.0.Brush}">
            <nc:NMenu
                Margin="20,36,20,20"
                DisplayMemberPath="Label"
                ItemInvoked="HandleOutlineItemInvoked"
                ItemsSource="{Binding OutlineItems}"
                SelectedValuePath="TargetName" />
        </Border>
    </Grid>
</UserControl>
